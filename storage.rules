rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function managerFor(competition) {
      return signedIn()
        && request.auth.token.get('ipfestRole', '') == 'competition_manager'
        && request.auth.token.get('ipfestCompetition', '') == competition;
    }

    function team(uid) {
      return firestore.get(/databases/(default)/documents/Team/$(uid)).data;
    }

    function canReadTeamFiles(uid) {
      return signedIn() && (request.auth.uid == uid || managerFor(team(uid).competition));
    }

    function treasury() {
      return signedIn() && request.auth.token.get('ipfestRole', '') == 'treasury';
    }

    function delegatesRelation() {
      return signedIn() && request.auth.token.get('ipfestRole', '') == 'delegates_relation';
    }

    function validTeamDocument(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+_(StudentID|Twibbon|Follow|AddToStory|LikeRepost)\\.pdf$');
    }

    function canReadPaymentProofs(uid) {
      return signedIn() && (request.auth.uid == uid || (treasury() && team(uid).competition != null));
    }

    function registeredParticipant(uid, participant) {
      return (participant == 'leader' && team(uid).leader != null)
        || (participant == 'member1' && team(uid).members.size() >= 1)
        || (participant == 'member2' && team(uid).members.size() >= 2)
        || (participant == 'member3' && team(uid).members.size() >= 3)
        || (participant == 'member4' && team(uid).members.size() >= 4);
    }

    function canReadParticipantDocument(uid, participant, fileName) {
      return treasury()
        && fileName in ['student_card.jpg', 'twibbon.jpg', 'follow_ig.jpg']
        && registeredParticipant(uid, participant);
    }

    function participantIn(competition) {
      return signedIn() && team(request.auth.uid).competition == competition;
    }

    function validUpload() {
      return request.resource != null
        && resource == null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|heic|heif)|application/(pdf|zip|x-zip-compressed|vnd.rar|x-rar-compressed|msword|vnd.ms-powerpoint|vnd.ms-excel|vnd.openxmlformats-officedocument\\.(wordprocessingml\\.document|presentationml\\.presentation|spreadsheetml\\.sheet))'
        );
    }

    match /Case/{competition}/{allPaths=**} {
      allow read: if managerFor(competition) || participantIn(competition);
      allow create: if managerFor(competition) && validUpload();
    }

    match /team/{uid}/{participant}/{fileName} {
      allow read: if (participant in ['leader', 'member1', 'member2', 'member3', 'member4'] && canReadTeamFiles(uid))
        || canReadParticipantDocument(uid, participant, fileName);
      allow create: if signedIn() && request.auth.uid == uid
        && participant in ['leader', 'member1', 'member2', 'member3', 'member4']
        && validUpload();
    }

    match /team/{uid}/documents/{fileName} {
      allow read: if validTeamDocument(fileName)
        && (request.auth.uid == uid || managerFor(team(uid).competition) || delegatesRelation());
      allow create: if signedIn() && request.auth.uid == uid
        && validTeamDocument(fileName)
        && request.resource.contentType == 'application/pdf'
        && validUpload();
    }

    match /payments/{uid}/{allPaths=**} {
      allow read: if canReadPaymentProofs(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /preliminary_submissions/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /final_submissions/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /finalreg_submissions/{uid}/{allPaths=**} {
      allow read: if canReadPaymentProofs(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
