rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function managerFor(competition) {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && (
          (competition == 'business case' && request.auth.token.get('email', '') == 'bcc.ipfest2027@gmail.com')
          || (competition == 'geothermal development plan' && request.auth.token.get('email', '') == 'gdpc.ipfest2027@gmail.com')
          || (competition == 'mud inovation' && request.auth.token.get('email', '') == 'mic.ipfest2027@gmail.com')
          || (competition == 'oil rig design' && request.auth.token.get('email', '') == 'ordc.ipfest2027@gmail.com')
          || (competition == 'plan of development' && request.auth.token.get('email', '') == 'podc.ipfest2027@gmail.com')
          || (competition == 'paper and poster' && request.auth.token.get('email', '') == 'ppc.ipfest2027@gmail.com')
          || (competition == 'smart competition' && request.auth.token.get('email', '') == 'sc.ipfest2027@gmail.com')
          || (competition == 'well design' && request.auth.token.get('email', '') == 'wdc.ipfest2027@gmail.com')
          || (competition == 'hackaton' && request.auth.token.get('email', '') == 'hc.ipfest2027@gmail.com')
        );
    }

    function team(uid) {
      return firestore.get(/databases/(default)/documents/Team/$(uid)).data;
    }

    function canReadTeamFiles(uid) {
      return signedIn() && (request.auth.uid == uid || managerFor(team(uid).competition));
    }

    function participantIn(competition) {
      return signedIn() && team(request.auth.uid).competition == competition;
    }

    function validUpload() {
      return request.resource != null
        && resource == null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|heic|heif)|application/(pdf|zip|x-zip-compressed|vnd.rar|x-rar-compressed|msword|vnd.ms-powerpoint|vnd.ms-excel|vnd.openxmlformats-officedocument\\.(wordprocessingml\\.document|presentationml\\.presentation|spreadsheetml\\.sheet))'
        );
    }

    match /Case/{competition}/{allPaths=**} {
      allow read: if managerFor(competition) || participantIn(competition);
      allow create: if managerFor(competition) && validUpload();
    }

    match /team/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /payments/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /preliminary_submissions/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /final_submissions/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /finalreg_submissions/{uid}/{allPaths=**} {
      allow read: if canReadTeamFiles(uid);
      allow create: if signedIn() && request.auth.uid == uid && validUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
